// Esquema do banco de dados (Prisma).
// Para trocar de banco (ex.: MySQL na VPS), mude o "provider" abaixo
// e o DATABASE_URL no .env. Depois rode: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Tabelas de autenticação (usadas pelo Better Auth)
// ─────────────────────────────────────────────

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  twoFactorEnabled Boolean?  @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions     Session[]
  accounts     Account[]
  twoFactors   TwoFactor[]
  memberships  HouseholdMember[]
  transactions Transaction[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

// Contas de login (email/senha ou Google). Não confundir com FinancialAccount.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // hash da senha, nunca a senha em texto
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

// Tokens de verificação de email e de redefinição de senha
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Segredo do autenticador (TOTP) e códigos de backup
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

// ─────────────────────────────────────────────
// Base das próximas fases: família, contas, categorias e lançamentos
// ─────────────────────────────────────────────

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AccountType {
  WALLET
  BANK
  CREDIT_CARD
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
}

enum TransactionSource {
  APP
  WHATSAPP
}

// Uma "casa": o grupo da família que compartilha as finanças
model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members      HouseholdMember[]
  accounts     FinancialAccount[]
  categories   Category[]
  transactions Transaction[]

  @@map("households")
}

model HouseholdMember {
  id          String     @id @default(cuid())
  householdId String
  userId      String
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

// Carteira, conta bancária ou cartão de crédito
model FinancialAccount {
  id             String      @id @default(cuid())
  householdId    String
  name           String
  type           AccountType
  initialBalance Decimal     @default(0) @db.Decimal(12, 2) // dinheiro sempre em Decimal, nunca float
  creditLimit    Decimal?    @db.Decimal(12, 2)
  closingDay     Int? // dia de fechamento da fatura (cartão)
  dueDay         Int? // dia de vencimento da fatura (cartão)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([householdId])
  @@map("financial_accounts")
}

model Category {
  id          String       @id @default(cuid())
  householdId String
  name        String
  type        CategoryType
  color       String
  icon        String
  createdAt   DateTime     @default(now())

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([householdId])
  @@map("categories")
}

model Transaction {
  id                String            @id @default(cuid())
  householdId       String
  accountId         String
  categoryId        String?
  createdById       String
  type              TransactionType
  amount            Decimal           @db.Decimal(12, 2)
  description       String
  date              DateTime
  status            TransactionStatus @default(CONFIRMED)
  installmentNumber Int? // parcela atual (ex.: 2 de 10)
  installmentTotal  Int?
  source            TransactionSource @default(APP)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category  Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User             @relation(fields: [createdById], references: [id])

  @@index([householdId, date])
  @@index([accountId])
  @@map("transactions")
}
