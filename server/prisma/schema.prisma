// Esquema do banco de dados (Prisma).
// Para trocar de banco (ex.: MySQL na VPS), mude o "provider" abaixo
// e o DATABASE_URL no .env. Depois rode: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Tabelas de autenticação (usadas pelo Better Auth)
// ─────────────────────────────────────────────

model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  twoFactorEnabled Boolean? @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions     Session[]
  accounts     Account[]
  twoFactors   TwoFactor[]
  memberships  HouseholdMember[]
  transactions Transaction[]

  // Espaço ativo (o último usado). Se a pessoa sair dele, voltamos ao mais antigo.
  lastHouseholdId  String?
  lastHousehold    Household?            @relation("LastHousehold", fields: [lastHouseholdId], references: [id], onDelete: SetNull)
  invitesSent      HouseholdInvite[]     @relation("InviteSentBy")
  alertPreferences AlertPreference[]
  sentAlerts       SentAlert[]
  whatsappLink     WhatsAppLink?
  whatsappCode     WhatsAppLinkCode?
  whatsappDrafts   WhatsAppDraft[]
  whatsappChat     WhatsAppChatMessage[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

// Contas de login (email/senha ou Google). Não confundir com FinancialAccount.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // hash da senha, nunca a senha em texto
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

// Tokens de verificação de email e de redefinição de senha
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Segredo do autenticador (TOTP) e códigos de backup
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

// ─────────────────────────────────────────────
// Base das próximas fases: família, contas, categorias e lançamentos
// ─────────────────────────────────────────────

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AccountType {
  WALLET
  BANK
  CREDIT_CARD
  INVESTMENT // conta de investimento (corretora, CDB, poupança...)
  OTHER // "Outros": conta que não é carteira, banco nem investimento
}

// Bandeira do cartão de crédito
enum CardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
}

// Repetição de receita/despesa comum (Lançamentos → Repetição)
enum Recurrence {
  INSTALLMENT // parcelado: o valor foi dividido entre as parcelas (k/N)
  REPEAT // repetido: o mesmo valor todo mês (k/N)
  FIXED // fixa mensal: 12 meses, o mesmo valor
}

enum TransactionSource {
  APP
  WHATSAPP
}

// Um "espaço": o grupo que compartilha as finanças (Pessoal, Família Martins...).
// Uma pessoa pode estar em vários espaços; cada um tem contas, cartões,
// categorias e lançamentos próprios.
model Household {
  id         String   @id @default(cuid())
  name       String
  // Espaço pessoal criado no cadastro: não pode ser apagado
  isPersonal Boolean  @default(false)
  createdAt  DateTime @default(now())

  members      HouseholdMember[]
  invites      HouseholdInvite[]
  lastUsedBy   User[]             @relation("LastHousehold")
  accounts     FinancialAccount[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  tags         Tag[]
  goals        Goal[]
  debts        Debt[]

  alertPreferences AlertPreference[]
  sentAlerts       SentAlert[]
  whatsappLinks    WhatsAppLink[]
  whatsappCodes    WhatsAppLinkCode[]
  whatsappDrafts   WhatsAppDraft[]
  whatsappChat     WhatsAppChatMessage[]

  @@map("households")
}

model HouseholdMember {
  id          String     @id @default(cuid())
  householdId String
  userId      String
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

// Convite para entrar num espaço (por email ou link para compartilhar).
// Guardamos só o hash do token; o link completo aparece uma vez (ao criar/reenviar).
model HouseholdInvite {
  id          String     @id @default(cuid())
  householdId String
  email       String? // vazio = convite por link (WhatsApp)
  role        MemberRole @default(MEMBER)
  tokenHash   String     @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  acceptedBy  String?
  canceledAt  DateTime?
  createdAt   DateTime   @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InviteSentBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_invites")
}

// Carteira, conta bancária, investimento ou cartão de crédito
model FinancialAccount {
  id               String      @id @default(cuid())
  householdId      String
  name             String
  type             AccountType
  initialBalance   Decimal     @default(0) @db.Decimal(12, 2) // dinheiro sempre em Decimal, nunca float
  creditLimit      Decimal?    @db.Decimal(12, 2)
  overdraftLimit   Decimal?    @db.Decimal(12, 2) // cheque especial (só conta bancária)
  bankLogo         String? // slug do logo do banco (public/bancos/<slug>.svg)
  accountNumber    String? // número da conta, só para identificar (ex.: ag. 1234 c/c 56789-0)
  notes            String? // dados adicionais (texto livre)
  isDefault        Boolean     @default(false) // conta padrão do espaço (no máximo uma); já vem escolhida em novas despesas/receitas
  showOnSummary    Boolean     @default(true) // aparece em "Suas contas" no Início
  ignoreInTotals   Boolean     @default(false) // fora do total/patrimônio do Início
  closingDay       Int? // dia de fechamento da fatura (cartão)
  dueDay           Int? // dia de vencimento da fatura (cartão)
  brand            CardBrand? // bandeira (cartão)
  color            String? // cor do cartão (#RRGGBB)
  paymentAccountId String? // conta que paga a fatura (opcional)
  archivedAt       DateTime? // cartão arquivado: some da lista e não recebe compras novas
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  household       Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  transfersIn     Transaction[]      @relation("TransferTo")
  paymentAccount  FinancialAccount?  @relation("CardPayment", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  cardsPaidByThis FinancialAccount[] @relation("CardPayment")
  budgetLinks     BudgetAccount[]
  goals           Goal[]
  debts           Debt[]

  @@index([householdId])
  @@map("financial_accounts")
}

model Category {
  id          String       @id @default(cuid())
  householdId String
  name        String
  type        CategoryType
  color       String
  icon        String
  // Subcategoria: aponta para a categoria-pai (um nível só). Apagar a pai apaga as filhas.
  parentId    String?
  createdAt   DateTime     @default(now())

  household    Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent       Category?          @relation("Subcategorias", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]         @relation("Subcategorias")
  transactions Transaction[]
  budgetLinks  BudgetCategory[]
  splits       TransactionSplit[]

  @@index([householdId])
  @@index([parentId])
  @@map("categories")
}

model Transaction {
  id                     String            @id @default(cuid())
  householdId            String
  accountId              String
  categoryId             String?
  // Quem lançou (vazio em lançamentos de quem apagou a conta)
  createdById            String?
  type                   TransactionType
  amount                 Decimal           @db.Decimal(12, 2)
  description            String
  date                   DateTime
  status                 TransactionStatus @default(CONFIRMED)
  installmentNumber      Int? // parcela atual (ex.: 2 de 10)
  installmentTotal       Int?
  // Transferência: accountId = origem, toAccountId = destino
  toAccountId            String?
  // Cartão: mês da fatura ("AAAA-MM", mês do vencimento). Compras (EXPENSE) e
  // pagamentos de fatura (TRANSFER para o cartão) guardam o mês aqui.
  invoiceMonth           String?
  // Cartão: as parcelas de uma mesma compra têm o mesmo purchaseId
  purchaseId             String?
  // Ajuste de saldo (Contas → "Ajustar saldo"): mexe no saldo da conta,
  // mas não conta como receita nem despesa no resumo do mês.
  isAdjustment           Boolean           @default(false)
  // Observações livres do lançamento
  notes                  String?
  // Receita/despesa repetida (parcelar, repetir ou fixa mensal): os lançamentos do
  // grupo têm o mesmo groupId. Editar ou apagar mexe só no lançamento escolhido.
  groupId                String?
  recurrence             Recurrence?
  source                 TransactionSource @default(APP)
  // Data em que o lançamento foi registrado / da compra (só informativa; o mês vem de "date")
  launchDate             DateTime?
  // Encargos (juros/multa) e desconto. "amount" já é o valor efetivo: valor + encargos − desconto
  fees                   Decimal?          @db.Decimal(12, 2)
  discount               Decimal?          @db.Decimal(12, 2)
  // Não efetivar automaticamente: fica pendente mesmo depois da data
  noAutoConfirm          Boolean           @default(false)
  // Onde o lançamento fica de fora
  ignoreInStatistics     Boolean           @default(false) // Estatísticas e Gráficos + "Despesas por categoria" do Início
  ignoreInBudgets        Boolean           @default(false) // Orçamentos
  ignoreInMonthlySavings Boolean           @default(false) // Economia mensal
  ignoreInTotals         Boolean           @default(false) // somas de receitas/despesas do mês (o saldo da conta continua real)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  splits      TransactionSplit[]
  tags        TransactionTag[]
  attachments TransactionAttachment[]
  goalEntries GoalEntry[]
  debtPayment DebtPayment?

  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   FinancialAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  toAccount FinancialAccount? @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Cascade)
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([householdId, date])
  @@index([accountId])
  @@index([toAccountId])
  @@index([householdId, invoiceMonth])
  @@index([purchaseId])
  @@index([groupId])
  @@map("transactions")
}

// Multicategorias: o valor efetivo do lançamento dividido entre categorias (a soma bate com "amount")
model TransactionSplit {
  id            String  @id @default(cuid())
  transactionId String
  // Apagar a categoria deixa a parte "sem categoria" (a soma continua batendo)
  categoryId    String?
  amount        Decimal @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([categoryId])
  @@map("transaction_splits")
}

// Tags do espaço (muitas por lançamento)
model Tag {
  id          String   @id @default(cuid())
  householdId String
  name        String
  color       String?
  createdAt   DateTime @default(now())

  household    Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([householdId, name])
  @@map("tags")
}

model TransactionTag {
  transactionId String
  tagId         String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
  @@map("transaction_tags")
}

// Anexos (foto ou PDF). O arquivo fica no armazenamento (disco: UPLOADS_DIR) pela "chave";
// aqui só os metadados.
model TransactionAttachment {
  id            String   @id @default(cuid())
  transactionId String
  originalName  String
  mime          String
  size          Int
  storageKey    String   @unique
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_attachments")
}

// ─────────────────────────────────────────────
// Orçamentos
// ─────────────────────────────────────────────

// Despesa = limite de gastos; Receita = quanto se espera receber
enum BudgetKind {
  EXPENSE
  INCOME
}

// Mensal: começa no mês de vigência e se repete todo mês até ser arquivado.
// Personalizado: período com início e fim (viagem, trimestre...).
enum BudgetPeriod {
  MONTHLY
  CUSTOM
}

// Meta: valor fixo, % do total de receitas do mês ou % da meta de um orçamento de receita
enum BudgetGoalType {
  FIXED
  PERCENT_INCOME
  PERCENT_BUDGET
}

// Compras no cartão contam pela data da compra ou pelo mês da fatura
enum BudgetCardDate {
  PURCHASE
  INVOICE
}

model Budget {
  id                String         @id @default(cuid())
  householdId       String
  kind              BudgetKind
  // Agrupado: soma de outros orçamentos mensais de despesa (sem filtros nem meta própria)
  isGroup           Boolean        @default(false)
  name              String
  color             String
  icon              String
  period            BudgetPeriod   @default(MONTHLY)
  startMonth        String? // mensal: mês de vigência "AAAA-MM"
  archivedFromMonth String? // mensal: arquivado a partir deste mês (os anteriores continuam no histórico)
  pausedMonths      String[]       @default([]) // mensal: meses "AAAA-MM" em que ficou arquivado e depois foi desarquivado mais adiante
  startDate         String? // personalizado: "AAAA-MM-DD" (dia em Brasília)
  endDate           String? // personalizado: "AAAA-MM-DD"
  goalType          BudgetGoalType @default(FIXED)
  // Meta fixa do personalizado (no mensal, as metas ficam em BudgetGoal, com histórico)
  amount            Decimal?       @db.Decimal(12, 2)
  percent           Decimal?       @db.Decimal(5, 2) // meta em %: 30 = 30%
  percentOfBudgetId String? // PERCENT_BUDGET: orçamento mensal de receita usado como base
  includeIgnored    Boolean        @default(false) // considera contas com "Ignorar nos totais"
  includePending    Boolean        @default(true) // Previsto: lançamentos pendentes também contam
  cardDateRef       BudgetCardDate @default(PURCHASE)
  alertPercent      Int? // alerta (despesa): avisa ao chegar a este % da meta. Vazio = sem alerta
  showOnHome        Boolean        @default(false) // aparece no Início
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  household      Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  percentOf      Budget?           @relation("BudgetPercentOf", fields: [percentOfBudgetId], references: [id], onDelete: NoAction)
  percentUsers   Budget[]          @relation("BudgetPercentOf")
  categories     BudgetCategory[]
  accounts       BudgetAccount[]
  goals          BudgetGoal[]
  components     BudgetGroupItem[] @relation("GroupItems")
  memberOfGroups BudgetGroupItem[] @relation("GroupMember")

  @@index([householdId, kind])
  @@map("budgets")
}

// Categorias do filtro (apagar a categoria tira ela do filtro)
model BudgetCategory {
  budgetId   String
  categoryId String

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([budgetId, categoryId])
  @@index([categoryId])
  @@map("budget_categories")
}

// Contas e cartões do filtro (só despesa; apagar a conta tira ela do filtro)
model BudgetAccount {
  budgetId  String
  accountId String

  budget  Budget           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([budgetId, accountId])
  @@index([accountId])
  @@map("budget_accounts")
}

// Orçamentos que fazem parte de um agrupado
model BudgetGroupItem {
  groupId  String
  budgetId String

  group  Budget @relation("GroupItems", fields: [groupId], references: [id], onDelete: Cascade)
  budget Budget @relation("GroupMember", fields: [budgetId], references: [id], onDelete: Cascade)

  @@id([groupId, budgetId])
  @@index([budgetId])
  @@map("budget_group_items")
}

// Histórico da meta (orçamento mensal com meta fixa).
// onlyMonth = false: vale de fromMonth em diante; true: só em fromMonth.
// isTransfer = true: ajuste (+/-) de "Transferir saldo", somado à meta só em fromMonth.
model BudgetGoal {
  id         String   @id @default(cuid())
  budgetId   String
  fromMonth  String
  amount     Decimal  @db.Decimal(12, 2)
  onlyMonth  Boolean  @default(false)
  isTransfer Boolean  @default(false)
  createdAt  DateTime @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, fromMonth])
  @@map("budget_goals")
}

// ─────────────────────────────────────────────
// Objetivos (guardar dinheiro para uma meta)
// ─────────────────────────────────────────────

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum GoalEntryKind {
  DEPOSIT
  WITHDRAWAL
}

// Guardado = initialAmount + depósitos − retiradas (só controle: não mexe em saldos
// nem em receitas/despesas, a não ser que o depósito/retirada crie uma transferência real)
model Goal {
  id            String     @id @default(cuid())
  householdId   String
  name          String
  color         String
  icon          String
  targetAmount  Decimal    @db.Decimal(12, 2)
  initialAmount Decimal    @default(0) @db.Decimal(12, 2) // já guardado antes de criar
  targetDate    String? // "AAAA-MM-DD" (dia em Brasília)
  description   String?
  // Conta onde o dinheiro fica (ex.: investimento). Apagar a conta só desvincula.
  accountId     String?
  status        GoalStatus @default(ACTIVE)
  showOnHome    Boolean    @default(true)
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  entries   GoalEntry[]

  @@index([householdId, status])
  @@index([accountId])
  @@map("goals")
}

// Depósito ou retirada. transactionId: a transferência real criada junto (opcional).
// Apagar a transferência em Lançamentos não apaga o depósito (só desvincula).
model GoalEntry {
  id            String        @id @default(cuid())
  goalId        String
  kind          GoalEntryKind
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime
  notes         String?
  transactionId String?
  createdById   String?
  createdAt     DateTime      @default(now())

  goal        Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([goalId, date])
  @@index([transactionId])
  @@map("goal_entries")
}

// ─────────────────────────────────────────────
// Dívidas (planejador de quitação)
// ─────────────────────────────────────────────

enum DebtType {
  CARTAO // cartão de crédito (rotativo, parcelamento de fatura)
  EMPRESTIMO // empréstimo pessoal, consignado
  FINANCIAMENTO // carro, casa
  CHEQUE_ESPECIAL
  PESSOAL // com amigos ou família
  OUTRA
}

enum DebtStatus {
  ACTIVE
  PAID // quitada (saldo chegou a zero)
  ARCHIVED
}

// Saldo devedor atual = startingBalance − soma dos pagamentos registrados (valor do lançamento de cada um).
// startingBalance é o saldo antes dos pagamentos registrados no app; ao editar o "saldo atual",
// guardamos saldo informado + já pago. Assim apagar um pagamento (ou o lançamento dele) devolve o saldo sozinho.
model Debt {
  id                  String     @id @default(cuid())
  householdId         String
  name                String
  creditor            String? // credor (banco, loja, pessoa)
  type                DebtType   @default(OUTRA)
  startingBalance     Decimal    @db.Decimal(12, 2)
  interestRateMonthly Decimal    @default(0) @db.Decimal(7, 4) // % ao mês: 2.5 = 2,5% a.m.
  minimumPayment      Decimal    @default(0) @db.Decimal(12, 2) // parcela ou pagamento mínimo por mês
  dueDay              Int? // dia do vencimento (1 a 31)
  notes               String?
  status              DebtStatus @default(ACTIVE)
  // Aparece no card "Dívidas" do Início (até 3 ativas)
  showOnHome          Boolean    @default(true)
  // Conta ou cartão relacionado (só referência). Apagar a conta só desvincula.
  accountId           String?
  createdById         String?
  paidAt              DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payments  DebtPayment[]

  @@index([householdId, status])
  @@index([accountId])
  @@map("debts")
}

// Pagamento de uma dívida: sempre junto com uma despesa (EXPENSE) em Lançamentos.
// Os dois são a mesma coisa: apagar o lançamento apaga o pagamento (Cascade) e o saldo devedor volta.
// "amount" é o valor no momento do registro; o saldo usa o valor atual do lançamento.
model DebtPayment {
  id            String   @id @default(cuid())
  debtId        String
  transactionId String   @unique
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime
  createdById   String?
  createdAt     DateTime @default(now())

  debt        Debt        @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([debtId, date])
  @@map("debt_payments")
}

// ─────────────────────────────────────────────
// Alertas (por e-mail; o canal fica separado para dar para ligar WhatsApp depois)
// ─────────────────────────────────────────────

// Por onde o alerta sai. WHATSAPP: só para quem ligou o número e ligou o tipo de alerta (opt-in).
enum AlertChannel {
  EMAIL
  WHATSAPP
}

enum AlertType {
  BUDGET_WARNING // orçamento chegou ao % de alerta (80% por padrão)
  BUDGET_OVER // orçamento passou de 100%
  INVOICE_DUE // fatura do cartão vence em X dias
  BILLS_DIGEST // resumo do dia: despesas pendentes que vencem hoje/amanhã
}

// Preferências de alerta de uma pessoa num espaço, por canal.
// Sem linha = padrão do papel: Dono tudo ligado; Membro tudo desligado (liga se quiser); Visualizador não recebe.
model AlertPreference {
  id                String       @id @default(cuid())
  userId            String
  householdId       String
  channel           AlertChannel @default(EMAIL)
  budget            Boolean      @default(true)
  invoice           Boolean      @default(true)
  bills             Boolean      @default(true)
  invoiceDaysBefore Int          @default(3) // fatura: quantos dias antes do vencimento (1 a 10)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId, channel])
  @@index([householdId])
  @@map("alert_preferences")
}

// Alertas já enviados (para não mandar duas vezes). refKey identifica o que foi avisado:
// orçamento "budgetId:período", fatura "cartaoId:AAAA-MM", resumo do dia "AAAA-MM-DD".
model SentAlert {
  id          String       @id @default(cuid())
  userId      String
  householdId String
  channel     AlertChannel
  type        AlertType
  refKey      String
  sentAt      DateTime     @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId, channel, type, refKey])
  @@index([householdId])
  @@map("sent_alerts")
}

// ─────────────────────────────────────────────
// Bot do WhatsApp (Meta WhatsApp Cloud API)
// ─────────────────────────────────────────────

// Número de WhatsApp ligado a uma pessoa (um número = uma pessoa).
// phone: o número que a pessoa digitou no app (E.164 sem "+", ex.: 5521999998888).
// waId: o número como o WhatsApp manda no webhook (no Brasil às vezes vem sem o 9). É para ele que o bot responde.
// householdId: espaço padrão onde o bot lança. Sair do espaço deixa vazio (o bot pede para escolher outro no app).
model WhatsAppLink {
  id          String            @id @default(cuid())
  userId      String            @unique
  phone       String            @unique
  waId        String            @unique
  householdId String?
  // Como o assistente responde: AUTO = áudio quando a pessoa manda áudio; TEXT = sempre texto; AUDIO = sempre áudio + texto
  replyMode   WhatsAppReplyMode @default(AUTO)
  linkedAt    DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@map("whatsapp_links")
}

// Código de 6 dígitos para ligar o número (um por pessoa, vale 10 minutos).
// Guardamos só o hash; o código aparece no app uma vez. attempts: códigos errados vindos desse número.
model WhatsAppLinkCode {
  id          String   @id @default(cuid())
  userId      String   @unique
  phone       String
  householdId String
  codeHash    String
  attempts    Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@map("whatsapp_link_codes")
}

// Mensagens recebidas já processadas (o Meta pode reenviar o mesmo webhook): id = wamid
model WhatsAppInbound {
  id         String   @id
  waId       String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
  @@map("whatsapp_inbound")
}

enum WhatsAppDraftStatus {
  PENDING
  CONFIRMED
  CANCELED
}

// Rascunho do lançamento enviado pelo WhatsApp: só vira lançamento ao tocar em "Confirmar".
// accountId: conta ou cartão. invoiceMonth: fatura (só cartão), calculada pela data da compra.
model WhatsAppDraft {
  id               String              @id @default(cuid())
  userId           String
  householdId      String
  waId             String
  type             TransactionType
  amount           Decimal             @db.Decimal(12, 2)
  description      String
  date             DateTime
  accountId        String
  categoryId       String?
  installments     Int                 @default(1)
  invoiceMonth     String?
  status           WhatsAppDraftStatus @default(PENDING)
  // Esperando a pessoa escolher a categoria (lista ou texto)
  awaitingCategory Boolean             @default(false)
  // Lançamento criado (1ª parcela, no cartão)
  transactionId    String?
  expiresAt        DateTime
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([waId, status])
  @@map("whatsapp_drafts")
}

// Preferência de resposta do assistente no WhatsApp (texto ou nota de voz)
enum WhatsAppReplyMode {
  AUTO
  TEXT
  AUDIO
}

enum WhatsAppChatRole {
  USER
  ASSISTANT
}

// Memória curta do assistente do WhatsApp: as últimas trocas da conversa (texto só).
// O assistente lê as últimas ~10 trocas dos últimos 45 minutos, do mesmo espaço.
// A limpeza (limparWhatsApp) apaga o que tem mais de 1 dia.
model WhatsAppChatMessage {
  id          String           @id @default(cuid())
  waId        String
  userId      String
  householdId String
  role        WhatsAppChatRole
  content     String
  createdAt   DateTime         @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([waId, createdAt])
  @@index([createdAt])
  @@map("whatsapp_chat_messages")
}
