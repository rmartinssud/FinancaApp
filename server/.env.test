# Usado só pelos testes (npm test). Banco separado do de desenvolvimento.
# Não tem segredo real: pode ficar no repositório.
NODE_ENV=test
DATABASE_URL="postgresql://financas:financas@localhost:5432/financas_test?schema=public"
BETTER_AUTH_SECRET="segredo-de-teste-com-mais-de-32-caracteres-123"
BETTER_AUTH_URL="http://localhost:3333"
FRONTEND_URL="http://localhost:5173"
AUTH_RATE_LIMIT=1000
UPLOADS_DIR="/tmp/financas-anexos-test"
# WhatsApp (valores falsos: os testes simulam o Meta com fetch mockado)
WHATSAPP_TOKEN="token-de-teste"
WHATSAPP_PHONE_NUMBER_ID="1234567890"
WHATSAPP_VERIFY_TOKEN="verifica-teste"
