# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o GitHub.

# Banco de dados (PostgreSQL local, Docker ou VPS)
DATABASE_URL="postgresql://financas:financas@localhost:5432/financas?schema=public"

# Segredo do login: gere com  openssl rand -hex 32
BETTER_AUTH_SECRET="troque-por-um-segredo-com-pelo-menos-32-caracteres"
# Endereço público onde a API (/api) é acessada.
# No dev é o próprio Vite (proxy). Em produção, o seu domínio (ex.: https://app.seudominio.com.br)
BETTER_AUTH_URL="http://localhost:5173"
# Endereço do frontend (CORS e redirecionamentos)
FRONTEND_URL="http://localhost:5173"
PORT=3333

# Cookies só por HTTPS. Em produção fica "true" automaticamente.
# COOKIE_SECURE=true

# Email (opcional). Sem SMTP, os links aparecem no console do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Finanças Pessoais <nao-responda@seudominio.com.br>"

# Login com Google (opcional). Só aparece se os dois estiverem preenchidos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tentativas por IP a cada 15 min nas rotas de login
# AUTH_RATE_LIMIT=30  (padrão: 30 em produção, 1000 em dev)

# Bot do WhatsApp (Meta WhatsApp Cloud API). Sem as quatro primeiras, o WhatsApp fica desligado.
# Webhook no Meta: https://SEU_DOMINIO/api/whatsapp/webhook (campo "messages")
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_VERSION=v21.0
# WHATSAPP_BOT_NUMBER="+55 21 3955-2279"

# Áudio e foto no WhatsApp (opcional). Sem chave, o bot avisa que chega em breve.
# Provedor de IA: Google Gemini (lê áudio e foto direto). AI_PROVIDER=gemini é o padrão.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Assistente de IA no WhatsApp (conversa, perguntas, simulações): liga sozinho com a chave do Gemini.
# "off" desliga e o bot volta ao modo de comandos (áudio e foto continuam usando a IA).
# WHATSAPP_ASSISTENTE=off
# Resposta em áudio (nota de voz) quando a pessoa manda áudio: liga sozinha com a chave do Gemini.
# "off" desliga (o assistente responde só em texto). Precisa do ffmpeg (já vem na imagem Docker).
# WHATSAPP_AUDIO_RESPOSTA=off
# Voz do Gemini TTS: modelo (padrão gemini-3.8-flash-tts; mais barato: gemini-3.8-flash-lite-tts) e voz pré-pronta.
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Sulafat
# FFMPEG_PATH=ffmpeg
